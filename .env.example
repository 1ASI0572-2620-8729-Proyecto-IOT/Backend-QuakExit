SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:mysql://localhost:3306/quakexit
DB_USER=root
DB_PASSWORD=replace-with-your-db-password

ADMIN_EMAIL=admin@quakexit.local
ADMIN_PASSWORD=replace-with-your-admin-password
